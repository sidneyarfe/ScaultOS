          "modo": "t-tri",
          "mid": true,
          "grupos": [
            {
              "texto": "E é exatamente isso que a Schola Cantorum faz.",
              "destaque": [
                "Schola Cantorum"
              ],
              "tag": "h1",
              "classe": "s"
            },
            {
              "texto": "Toda vez que entoamos um desses hinos, damos continuidade a uma tradição que atravessa países, décadas e idiomas.",
              "tag": "p"
            }
          ]
        }
      },
      "fundo": "<div class=\"glow\"></div>"
