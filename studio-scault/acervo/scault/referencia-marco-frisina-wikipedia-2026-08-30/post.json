            {
              "texto": "Su Ali D'Aquila. Resta Qui Con Noi. Emmanuel. Magnificat.",
              "destaque": [
                "Su Ali D'Aquila"
              ],
              "tag": "h2"
            },
            {
              "texto": "Canções escritas por Frisina para as missas de Roma foram traduzidas, adaptadas e hoje fazem parte do repertório de corais e schola cantorums em todo o mundo — inclusive no Brasil.",
              "tag": "p"
            }
          ]
        }
      },
